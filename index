/* ============================================================
   [CSS 100] v3 TAILORED LAYER — 질감 · 리더 · 신호 · 테이프 · 도장
   ============================================================ */
/* 필름 그레인: SVG feTurbulence를 data-URI 대신 인라인 svg로, steps 지터 */
.grain{position:fixed;inset:-50%;z-index:80;pointer-events:none;opacity:.075;mix-blend-mode:multiply;animation:grain 1.1s steps(6) infinite}
.grain svg{width:100%;height:100%}
@keyframes grain{0%{transform:translate(0,0)}20%{transform:translate(-3%,2%)}40%{transform:translate(2%,-3%)}60%{transform:translate(-2%,-1%)}80%{transform:translate(3%,3%)}100%{transform:translate(0,0)}}
/* 비네팅: 화면 가장자리가 아주 조금 어두워짐 */
.vignette{position:fixed;inset:0;z-index:79;pointer-events:none;background:radial-gradient(120% 90% at 50% 45%,transparent 55%,rgba(17,19,18,.16) 100%)}

/* 필름 리더 (3·2·1) — 첫 진입 시 */
.leader{position:fixed;inset:0;z-index:100;background:#cfd0ce;display:grid;place-items:center;cursor:pointer;transition:opacity .8s var(--ease),visibility .8s}
.leader.out{opacity:0;visibility:hidden}
.leader svg{width:min(62vmin,440px);height:auto;overflow:visible}
.leader .lc{fill:none;stroke:var(--ink);stroke-width:1}
.leader .lc.thin{opacity:.35}
.leader .sweep{fill:rgba(17,19,18,.10);stroke:none}
.leader .num{font-family:var(--sans);font-weight:300;font-size:150px;fill:var(--ink);text-anchor:middle;dominant-baseline:central;font-variant-numeric:tabular-nums}
.leader .lt{font-family:var(--mono);font-size:8px;fill:var(--mute);letter-spacing:.12em}
.leader .lt.g{fill:var(--green)}
.leader .skip{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);font-family:var(--sans);font-size:10px;letter-spacing:.3em;color:var(--mute)}
.leader .perf{position:absolute;top:0;bottom:0;width:22px;background:repeating-linear-gradient(to bottom,transparent 0 14px,rgba(17,19,18,.22) 14px 24px)}
.leader .perf.l{left:18px}.leader .perf.r{right:18px}

/* 이미지 placeholder — 회색 박스 대신 "NO SIGNAL" 해칭 슬레이트 */
.ph.missing{background:#b2b4b2}
.ph.missing::after{content:none}
.ph .nosig{position:absolute;inset:0;width:100%;height:100%;z-index:1}
.ph .nosig .hatch line{stroke:rgba(17,19,18,.13);stroke-width:1}
.ph .nosig .x{stroke:rgba(17,19,18,.22);stroke-width:1;fill:none;vector-effect:non-scaling-stroke}
.ph .nosig-lab{position:absolute;left:10px;right:10px;bottom:8px;z-index:2;display:flex;justify-content:space-between;gap:8px;font-family:var(--mono);font-size:9.5px;color:rgba(17,19,18,.6);pointer-events:none}
.ph .nosig-lab b{font-weight:400;color:var(--green);letter-spacing:.14em}
.ph .nosig-c{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;font-family:var(--sans);font-size:10px;letter-spacing:.4em;color:rgba(17,19,18,.45);white-space:nowrap;pointer-events:none}
.ph .nosig-c::before{content:"";display:inline-block;width:6px;height:6px;background:var(--green);margin-right:10px;vertical-align:1px;animation:blink 1.6s steps(2) infinite}
@keyframes blink{50%{opacity:0}}

/* HERO — 2040 연도 롤 · 네온 플리커 · 실시간 시계 */
.hero-meta .yr{position:relative}
.hero-meta .yr .d{display:inline-block;min-width:.56em;text-align:center}
body.entered .logo-v .rs::after{animation:neon 6s 1.4s infinite}
@keyframes neon{0%,92%,100%{opacity:1}93%{opacity:.15}94%{opacity:1}96%{opacity:.3}97%{opacity:1}}
.slate .live-dot{display:inline-block;width:5px;height:5px;background:var(--green);margin-right:6px;vertical-align:1px;animation:blink 1s steps(2) infinite}
.scroll-hint{display:flex;flex-direction:column;align-items:center;gap:8px}
.scroll-hint svg{width:9px;height:42px;overflow:visible}
.scroll-hint svg line{stroke:var(--black);stroke-width:1}
.scroll-hint svg .drop{stroke:var(--green);stroke-dasharray:10 42;animation:drop 1.8s var(--ease) infinite}
@keyframes drop{from{stroke-dashoffset:10}to{stroke-dashoffset:-42}}
/* 히어로 측면 눈금: 스크롤에 따라 움직이는 거리 표시 */
.hero-scale{position:absolute;right:calc(var(--pad) * .6 - 4px);top:22%;bottom:30%;width:10px;z-index:3;opacity:0;transition:opacity .8s var(--ease) .6s}
body.entered .hero-scale{opacity:.8}
.hero-scale svg{width:100%;height:100%;overflow:visible}
.hero-scale line{stroke:var(--black);stroke-width:1;vector-effect:non-scaling-stroke}

/* 01 — 재개발 공지 테이프 (스크롤 속도 연동 marquee) */
.tape{position:relative;margin:16vh calc(var(--pad) * -1) 0;height:64px;overflow:hidden;transform:rotate(-1.2deg);
  border-top:var(--rule);border-bottom:var(--rule);background:rgba(210,211,209,.55)}
.tape::before,.tape::after{content:"";position:absolute;left:0;right:0;height:8px;
  background:repeating-linear-gradient(-45deg,var(--ink) 0 6px,transparent 6px 14px);opacity:.75}
.tape::before{top:0}.tape::after{bottom:0}
.tape .track{position:absolute;top:50%;left:0;display:flex;white-space:nowrap;transform:translateY(-50%);will-change:transform}
.tape .track span{font-family:var(--sans);font-size:12px;letter-spacing:.34em;padding-right:2.4em;display:inline-flex;align-items:center;gap:2.4em}
.tape .track span i{font-style:normal;font-family:var(--jp);letter-spacing:.3em}
.tape .track span em{font-style:normal;color:var(--green)}

/* 01 지도 보강 */
.kmap .tokyo{fill:rgba(17,19,18,.05);stroke:none}
.kmap .north path{fill:none;stroke:var(--ink);stroke-width:1}
.kmap .north text,.kmap .scale text{font-family:var(--mono);font-size:6.5px;fill:var(--mute)}
.kmap .scale line{stroke:var(--ink);stroke-width:1}
.kmap .pulse{fill:none;stroke:var(--green);stroke-width:1;opacity:0}
.kmap .pt.on .pulse{animation:pulse 1.4s var(--ease) infinite}
@keyframes pulse{0%{opacity:.9;transform:scale(.6)}100%{opacity:0;transform:scale(2.4)}}
.kmap .pt .pulse{transform-box:fill-box;transform-origin:center}
.kmap .scan{stroke:var(--green);stroke-width:1;opacity:.35}
.kmap-read{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9.5px;color:var(--mute);margin-top:6px}
.kmap-read b{font-weight:400;color:var(--green)}

/* 섹션 인덱스 스크램블 중 글자 */
.idx .sc{color:var(--green)}

/* 03 — RESIST 도장 · 카운터 셀 */
.dogma{position:relative}
.stamp{position:absolute;right:-6px;top:38px;width:62px;height:62px;pointer-events:none;opacity:0;transform:rotate(-14deg) scale(1.8);transition:opacity .25s,transform .45s cubic-bezier(.3,1.6,.5,1)}
.stamp rect{fill:none;stroke:var(--green);stroke-width:1.6}
.stamp text{font-family:var(--jp);font-weight:500;fill:var(--green);text-anchor:middle}
.stamp .sm{font-family:var(--mono);font-size:6px;font-weight:400}
.dogma.resisted .stamp{opacity:.85;transform:rotate(-14deg) scale(1)}
.resist-count{display:flex;align-items:center;gap:10px}
.resist-count .cells{display:flex;gap:3px}
.resist-count .cells i{width:7px;height:7px;border:1px solid var(--mute);transition:background .3s,border-color .3s}
.resist-count .cells i.on{background:var(--green);border-color:var(--green)}
body.all-resisted #thread .live{stroke:var(--green)}
body.all-resisted #thread .head-ring{animation:ring 1.6s infinite}
@keyframes ring{50%{opacity:0}}
.toast{position:fixed;left:50%;bottom:22px;z-index:70;transform:translate(-50%,24px);opacity:0;pointer-events:none;
  font-family:var(--mono);font-size:10px;letter-spacing:.12em;background:var(--ink);color:#d2d3d1;padding:8px 14px;transition:all .6s var(--ease)}
.toast.on{opacity:1;transform:translate(-50%,0)}
.toast b{color:#8fc3ad;font-weight:400}
.ev.now .coda{margin-top:18px;font-family:var(--mono);font-size:10px;color:var(--green);opacity:0;transition:opacity .8s}
body.all-resisted .ev.now .coda{opacity:1}

/* 04 — 눈금자 판독 바늘 */
#ruler .needle{stroke:var(--green);stroke-width:1;opacity:1}
#ruler .needle-t{fill:var(--green)}

/* 키보드 단축 힌트 */
.kbd{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:50;font-family:var(--mono);font-size:9.5px;color:var(--mute);opacity:0;transition:opacity .6s}
body.entered:not([data-sec="hero"]) .kbd{opacity:.55}

@media (max-width:820px){
  .tape{height:52px}.tape .track span{font-size:10px}
  .stamp{width:48px;height:48px;top:30px}
  .kbd,.hero-scale{display:none}
  .leader .perf{display:none}
}
@media (prefers-reduced-motion:reduce){ .grain{animation:none} .leader{display:none} }
</style>
</head>

