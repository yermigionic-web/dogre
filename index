/* ============================================================
   [JS 12] 04 TIMELINE — 눈금자 SVG · 연도 scrub · lightbox
   ============================================================ */
var ruler=$('#ruler'), rail=$('#rail'), evs=$$('.ev'), tYear=$('#tYear');
function buildRuler(){
  var h=rail.offsetHeight, ns='http://www.w3.org/2000/svg', out='';
  ruler.setAttribute('height',h);
  for(var y=0;y<h;y+=24){ var major = (y/24)%10===0;
    out+='<line x1="'+(major?0:7)+'" x2="14" y1="'+y+'" y2="'+y+'" class="'+(major?'major':'')+'"/>'; }
  ruler.innerHTML=out;
}
function updateTimeline(){
  var cur=null; evs.forEach(function(ev){ if(ev.getBoundingClientRect().top<innerHeight*.45) cur=ev; });
  evs.forEach(function(ev){ ev.classList.toggle('cur', ev===cur && ev.classList.contains('now')); });
