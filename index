/* ============================================================
   [JS 100] v3 TAILORED LAYER
   ============================================================ */
var NS='http://www.w3.org/2000/svg';

/* --- 필름 리더: 3 → 2 → 1 → 사라짐 --- */
(function(){
  var L=$('#leader'); if(!L) return;
  if(reduce || sessionStorage.getItem('dr-leader')){ L.remove(); return; }
  var sweep=$('#sweep'), num=$('#leaderNum'), ltc=$('#leaderTc'), st=performance.now(), done=false, SEC=900;
  function arc(p){ if(p<=0) return ''; if(p>=1) p=.9999; var a=p*Math.PI*2-Math.PI/2, r=100,
      x=Math.cos(a)*r, y=Math.sin(a)*r; return 'M0 0 L0 -100 A100 100 0 '+(p>.5?1:0)+' 1 '+x.toFixed(2)+' '+y.toFixed(2)+' Z'; }
  function end(){ if(done) return; done=true; sessionStorage.setItem('dr-leader',1); L.classList.add('out'); setTimeout(function(){ L.remove(); },900); }
  (function tick(now){ if(done) return; var t=now-st, i=Math.floor(t/SEC);
    if(i>2){ end(); return; }
    num.textContent=3-i; sweep.setAttribute('d',arc((t%SEC)/SEC));
    var f=Math.floor(t/1000*24); ltc.textContent='00:00:'+pad2(Math.floor(f/24))+':'+pad2(f%24);
    requestAnimationFrame(tick); })(st);
  L.addEventListener('click',end); addEventListener('keydown',function k(){ end(); removeEventListener('keydown',k); });
})();

/* --- NO SIGNAL placeholder: 해칭 SVG + 파일명 + 해상도 표시 --- */
function noSignal(fig){
  if(fig.querySelector('.nosig')) return;
  var w=fig.clientWidth||400, h=fig.clientHeight||300, g='';
  for(var x=-h;x<w;x+=9) g+='<line x1="'+x+'" y1="'+h+'" x2="'+(x+h)+'" y2="0"/>';
  fig.insertAdjacentHTML('afterbegin',
    '<svg class="nosig" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none" aria-hidden="true"><g class="hatch">'+g+'</g>'+
    '<path class="x" d="M0 0L'+w+' '+h+'M'+w+' 0L0 '+h+'"/></svg>'+
    '<span class="nosig-c">NO SIGNAL</span>'+
    '<span class="nosig-lab"><span>'+(fig.dataset.file||'').split('/').pop()+'</span><b>'+w+'×'+h+'</b></span>');
}
function clearSignal(fig){ $$('.nosig,.nosig-c,.nosig-lab',fig).forEach(function(n){ n.remove(); }); }
var phObs=new MutationObserver(function(m){ m.forEach(function(r){ var f=r.target;
  if(f.classList.contains('missing')) noSignal(f); else clearSignal(f); }); });
$$('.ph').forEach(function(f){ phObs.observe(f,{attributes:true,attributeFilter:['class']}); if(f.classList.contains('missing')) noSignal(f); });

/* --- 텍스트 스크램블 (라틴 + 가타카나) --- */
var GLY='ABCDEFGHJKLMNPRSTUVWXYZ0123456789アイウエオカキクケコサシスセソタチツテトナニヌネノ';
function scramble(el,text,dur){
  if(reduce){ el.textContent=text; return; }
  var st=performance.now(); dur=dur||700;
  (function f(now){ var p=Math.min(1,(now-st)/dur), n=Math.floor(p*text.length), out='';
    for(var i=0;i<text.length;i++){ var c=text[i];
      out += (i<n||c===' '||c==='—') ? c : GLY[(Math.random()*GLY.length)|0]; }
    el.textContent=out; if(p<1) requestAnimationFrame(f); })(st);
}
var idxIO=new IntersectionObserver(function(en){ en.forEach(function(x){ if(!x.isIntersecting) return;
  var b=x.target.querySelector('b'), tn=b && b.nextSibling; if(tn && tn.nodeType===3){
    var sp=document.createElement('span'); sp.textContent=tn.textContent; tn.replaceWith(sp); scramble(sp,sp.textContent,900); }
  idxIO.unobserve(x.target); }); },{threshold:.6});
$$('.chapter .idx').forEach(function(el){ idxIO.observe(el); });
/* folio 교체 시에도 스크램블 */
var _swap=swapFolio; swapFolio=function(sec){ _swap(sec); setTimeout(function(){ scramble(folioA,sec.dataset.folio,500); },reduce?0:320); };

/* --- HERO: 2026 → 2040 롤 / 2040년 실시간 시계 / 측면 눈금 --- */
var heroYear=$('#heroYear');
heroYear.innerHTML='2040'.split('').map(function(d){ return '<span class="d">'+d+'</span>'; }).join('');
$('#enterBtn').addEventListener('click',function(){
  if(reduce) return; var ds=$$('.d',heroYear), st=performance.now();
  (function f(now){ var p=Math.min(1,(now-st)/1400), y=Math.round(2026+(14*(1-Math.pow(1-p,3)))), s=String(y);
    ds.forEach(function(d,i){ d.textContent = (p<1 && i>1 && Math.random()<.35) ? ((Math.random()*10)|0) : s[i]; });
    if(p<1) requestAnimationFrame(f); else ds.forEach(function(d,i){ d.textContent='2040'[i]; }); })(st);
});
var clock40=$('#clock40'), WD=['SUN','MON','TUE','WED','THU','FRI','SAT'];
function drawClock(){ var n=new Date(Date.now()+ (9*60+new Date().getTimezoneOffset())*60000), y=new Date(n); y.setFullYear(2040);
  clock40.textContent='2040.'+pad2(y.getMonth()+1)+'.'+pad2(y.getDate())+' '+WD[y.getDay()]+' — '+pad2(n.getHours())+':'+pad2(n.getMinutes())+':'+pad2(n.getSeconds())+' JST'; }
drawClock(); setInterval(drawClock,1000);
var hs=$('#heroScale');
function drawHeroScale(){ var h=hs.clientHeight||300, off=(scrollY*.35)%12, o='<line x1="10" y1="0" x2="10" y2="'+h+'" style="opacity:.3"/>';
  for(var y=-off;y<h;y+=12){ var k=Math.round((y+off+scrollY*.35)/12)%5===0; o+='<line x1="'+(k?0:5)+'" x2="10" y1="'+y.toFixed(1)+'" y2="'+y.toFixed(1)+'"/>'; }
  hs.innerHTML=o; }

/* --- 01: 공지 테이프 (스크롤 속도에 반응) --- */
var tape=$('#tapeTrack'), tx=0, vel=0, lastY=scrollY;
var TAPE='<span><em>■</em> REDEVELOPMENT ZONE <i>再開発区域</i> KEEP OUT <i>立入禁止</i> DEMOLITION SCHEDULED 2040.11 <i>解体予定</i> KAWAGUCHI CITY <i>川口市</i></span>';
tape.innerHTML=TAPE+TAPE+TAPE+TAPE;
function drawTape(){ var d=scrollY-lastY; lastY=scrollY; vel += (d*.6 - vel)*.12;
  tx -= reduce ? 0 : (.45 + Math.abs(vel)*.5) * (vel<-.5?-1:1);
  var w=tape.firstChild.offsetWidth||1; if(tx<-w) tx+=w; if(tx>0) tx-=w;
  tape.style.transform='translate('+tx.toFixed(1)+'px,-50%)'; }

/* --- 01: 지도 스캔라인 + 좌표 판독 --- */
