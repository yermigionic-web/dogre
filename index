/* --- 04: 눈금자 판독 바늘 --- */
var _br=buildRuler; buildRuler=function(){ _br();
  ruler.insertAdjacentHTML('beforeend','<line class="needle" id="needle" x1="-22" x2="14" y1="0" y2="0"/><rect class="needle-t" id="needleT" x="-25" y="-2" width="4" height="4"/>'); };
