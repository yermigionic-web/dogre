/* --- 03: RESIST 도장 + 카운터 셀 + 6/6 해금 --- */
var cells=$$('#rcCells i'), toast=$('#toast'), tT;
function showToast(html){ toast.innerHTML=html; toast.classList.add('on'); clearTimeout(tT); tT=setTimeout(function(){ toast.classList.remove('on'); },2600); }
$$('.dogma').forEach(function(dg,i){
