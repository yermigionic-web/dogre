}
function updateSections(){
  var mid=innerHeight*.5, cur=sections[0];
  sections.forEach(function(s){ if(s.getBoundingClientRect().top<=mid) cur=s; });
  if(cur.id!==curId){
    curId=cur.id; document.body.dataset.sec=cur.id;
    document.body.style.backgroundColor=cur.dataset.bg;
    navLinks.forEach(function(a){ a.classList.toggle('active', a.dataset.sec===cur.id); });
    swapFolio(cur);
  }
  var r=cur.getBoundingClientRect(), p=Math.min(1,Math.max(0,(mid-r.top)/r.height));
  navProg.style.width=(p*100)+'%';
}

/* ============================================================
   [JS 08] 01 KAWAGUCHI — 뷰파인더 커서 + 지도 연동
   ============================================================ */
var finder=$('#finder'), flab=$('#finderLab');
$$('.k-shot').forEach(function(el){
  var fig=$('.ph',el), pt=$('.kmap .pt[data-pt="'+el.dataset.loc+'"]');
  el.addEventListener('mouseenter',function(){ if(pt) pt.classList.add('on'); if(!isMobile()) finder.classList.add('on'); });
  el.addEventListener('mouseleave',function(){ if(pt) pt.classList.remove('on'); finder.classList.remove('on'); });
  el.addEventListener('mousemove',function(e){
    var r=fig.getBoundingClientRect(), x=(e.clientX-r.left)/r.width, y=(e.clientY-r.top)/r.height;
    finder.style.transform='translate('+e.clientX+'px,'+e.clientY+'px)';
    flab.textContent = 'FIG.'+el.querySelector('.k-cap span:last-child').textContent.slice(4)+'  X '+x.toFixed(2)+' · Y '+y.toFixed(2);
  });
});

/* ============================================================
   [JS 09] 03 DOGMA RESIST — SVG 취소선
   ============================================================ */
var rc=$('#rc'), rcBox=$('#resistCount');
$$('.dogma').forEach(function(dg){
  var q=$('.q',dg), ns='http://www.w3.org/2000/svg', s=document.createElementNS(ns,'svg'), p=document.createElementNS(ns,'path');
  s.setAttribute('viewBox','0 0 100 10'); s.setAttribute('preserveAspectRatio','none');
  /* 직선으로 긋다가 끝에서 위로 꺾임 = 저항 */
  p.setAttribute('d','M0 6 H94 L100 1'); p.setAttribute('pathLength','1'); p.setAttribute('vector-effect','non-scaling-stroke');
  s.appendChild(p); q.appendChild(s);
  $('.resist-btn',dg).addEventListener('click',function(){
    var on=dg.classList.toggle('resisted'); this.setAttribute('aria-pressed',on);
    this.textContent = on ? 'RESISTED' : 'RESIST';
    var n=$$('.dogma.resisted').length; rc.textContent=n; rcBox.classList.toggle('show', n>0);
  });
});

/* ============================================================
   [JS 10] 03 인물 이미지 미세 패닝 + 일본어 장식 drift + sub-index
   ============================================================ */
if(!reduce){
  $$('.person .img').forEach(function(fig){
    fig.addEventListener('mousemove',function(e){
      var r=fig.getBoundingClientRect();
      fig.style.setProperty('--mx', (((e.clientX-r.left)/r.width-.5)*-2.4).toFixed(2)+'%');
      fig.style.setProperty('--my', (((e.clientY-r.top)/r.height-.5)*-2.4).toFixed(2)+'%');
    });
    fig.addEventListener('mouseleave',function(){ fig.style.setProperty('--mx','0'); fig.style.setProperty('--my','0'); });
  });
}
var drifts=$$('[data-drift]'), persons=$$('.person'), pLinks=$$('.p-index a');
function updatePeople(){
  if(!reduce) drifts.forEach(function(d){
    var r=d.parentElement.getBoundingClientRect(); d.style.transform='translateY('+((r.top-innerHeight/2)*-.08).toFixed(1)+'px)'; });
  var cur=null; persons.forEach(function(p){ if(p.getBoundingClientRect().top<innerHeight*.5) cur=p.id; });
  pLinks.forEach(function(a){ a.classList.toggle('on', a.dataset.p===cur); });
}

/* ============================================================
   [JS 11] HERO 마우스 패럴랙스 (아주 미세)
