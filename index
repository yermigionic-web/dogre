<script>
(function(){
var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
var isMobile = function(){ return innerWidth <= 820; };
var $ = function(s,c){ return (c||document).querySelector(s); };
var $$ = function(s,c){ return Array.prototype.slice.call((c||document).querySelectorAll(s)); };

/* ============================================================
   [JS 01] 이미지 placeholder
   ============================================================ */
function watch(img){
  var fig = img.closest('.ph'); if(!fig) return;
  var fail = function(){ fig.classList.add('missing'); };
  if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) fail();
  img.addEventListener('error', fail);
  img.addEventListener('load', function(){ fig.classList.remove('missing'); });
}
$$('.ph img').forEach(watch);

/* ============================================================
   [JS 02] BGM — 단일 instance / 없으면 조용히 비활성
   ============================================================ */
var bgm = $('#bgm'), soundBtn = $('#soundBtn'), soundLabel = $('#soundLabel');
var audioOK = true, VOLUME = 0.35;
bgm.loop = true; bgm.volume = VOLUME;
bgm.addEventListener('error', function(){ audioOK = false; soundBtn.hidden = true; });
function setSoundUI(on){ soundBtn.classList.toggle('on',on); soundBtn.setAttribute('aria-pressed',on);
  soundLabel.textContent = on ? 'SOUND ON' : 'SOUND OFF'; }
function playBGM(){
  if(!audioOK) return;
  try{ var p = bgm.play();
    if(p && p.then) p.then(function(){ setSoundUI(true); soundBtn.classList.add('ready'); })
      .catch(function(){ if(bgm.error) soundBtn.hidden = true; else { setSoundUI(false); soundBtn.classList.add('ready'); } });
  }catch(e){ soundBtn.hidden = true; }
}
soundBtn.addEventListener('click', function(){
  if(!audioOK) return;
  if(bgm.paused) playBGM(); else { bgm.pause(); setSoundUI(false); }
});

/* ============================================================
   [JS 03] 크롭마크 SVG 주입 (data-crop 이미지)
   ============================================================ */
$$('[data-crop]').forEach(function(fig){
  var ns='http://www.w3.org/2000/svg', s=document.createElementNS(ns,'svg');
  s.setAttribute('class','crop'); s.setAttribute('viewBox','0 0 100 100'); s.setAttribute('preserveAspectRatio','none');
  var p=document.createElementNS(ns,'path');
  p.setAttribute('d','M0 6V0H6 M94 0H100V6 M100 94V100H94 M6 100H0V94');
  s.appendChild(p); fig.appendChild(s);
});

/* ============================================================
   [JS 04] 사운드 SVG 파형 (ON일 때만 진폭 움직임)
   ============================================================ */
var wave = $('#wave'), t0 = performance.now();
function drawWave(now){
  var on = !bgm.paused && !reduce, pts=[];
  for(var x=0;x<=22;x+=2){
    var a = on ? Math.sin((now-t0)/180 + x*.7)*Math.sin(x/22*Math.PI)*4 : 0;
    pts.push(x+','+(5+a).toFixed(2));
  }
  wave.setAttribute('points', pts.join(' '));
}

/* ============================================================
   [JS 05] SITE ENTRY + 타임코드
   ============================================================ */
var tc = $('#tc'), entered=false, tStart=0;
$('#enterBtn').addEventListener('click', function(){
  playBGM();
  document.body.classList.remove('is-intro');
  document.body.classList.add('entered');
  entered = true; tStart = performance.now();
  setTimeout(buildThread, 900);   /* HERO 재배치 후 선 재계산 */
});
function pad2(n){ return (n<10?'0':'')+n; }
function drawTC(now){
  if(!entered) return;
  var sec = (!bgm.paused && bgm.currentTime) ? bgm.currentTime : (now - tStart)/1000;
  var f = Math.floor((sec%1)*24), s = Math.floor(sec)%60, m = Math.floor(sec/60)%60, h=Math.floor(sec/3600);
  tc.textContent = pad2(h)+':'+pad2(m)+':'+pad2(s)+':'+pad2(f);
}

/* ============================================================
   [JS 06] THE THREAD — 직각 polyline 생성 + 스크롤 드로잉
   data-thread="x,y|dir"  x,y = 요소 박스 기준 (px 또는 %)
   dir = h : 가로 먼저 이동 후 세로 / v : 세로 먼저 이동 후 가로
   data-thread-m = 모바일 전용 값
   ============================================================ */
var main = $('#main'), svg = $('#thread'), ghost=$('#threadGhost'), live=$('#threadLive'),
    head=$('#threadHead'), ring=$('#headRing'), knotsG=$('#knots');
var segs=[], total=0, verts=[];
function val(v,size){ v=v.trim(); return v.slice(-1)==='%' ? parseFloat(v)/100*size : parseFloat(v)||0; }
function buildThread(){
  var mr = main.getBoundingClientRect(), pts=[];
  $$('[data-thread]').forEach(function(el){
    var spec = (isMobile() && el.dataset.threadM) || el.dataset.thread;
    var parts = spec.split('|'), xy = parts[0].split(','), r = el.getBoundingClientRect();
    pts.push({x: r.left - mr.left + val(xy[0], r.width), y: r.top - mr.top + val(xy[1], r.height),
              dir: parts[1]||'h', ext: el.hasAttribute('data-extend')});
  });
  if(!pts.length) return;
  verts=[{x:pts[0].x,y:pts[0].y}];
  for(var i=1;i<pts.length;i++){
    var a=verts[verts.length-1], b=pts[i];
    if(b.dir==='v'){ verts.push({x:a.x,y:b.y}); } else { verts.push({x:b.x,y:a.y}); }
    verts.push({x:b.x,y:b.y});
    if(b.ext) verts.push({x:b.x,y:main.scrollHeight + innerHeight}); /* 화면 밖까지 */
  }
  /* 중복점 제거 */
  verts = verts.filter(function(p,i){ return i===0 || p.x!==verts[i-1].x || p.y!==verts[i-1].y; });
  var d='M'+verts.map(function(p){return p.x.toFixed(1)+' '+p.y.toFixed(1);}).join(' L');
  ghost.setAttribute('d',d); live.setAttribute('d',d);
  svg.setAttribute('height', main.scrollHeight); svg.style.height = main.scrollHeight+'px';
  segs=[]; total=0;
  for(var j=1;j<verts.length;j++){
    var L=Math.abs(verts[j].x-verts[j-1].x)+Math.abs(verts[j].y-verts[j-1].y);
    segs.push({a:verts[j-1],b:verts[j],s:total,L:L}); total+=L;
  }
  live.style.strokeDasharray = total; 
  /* 꺾이는 지점(knot) = RESIST 지점: 작은 사각형 */
  knotsG.innerHTML='';
  verts.slice(1,-1).forEach(function(p){
    var r=document.createElementNS('http://www.w3.org/2000/svg','rect');
    r.setAttribute('x',p.x-2.5); r.setAttribute('y',p.y-2.5); r.setAttribute('width',5); r.setAttribute('height',5);
    r.setAttribute('class','knot'); r.dataset.y=p.y; knotsG.appendChild(r);
  });
  updateThread();
}
function updateThread(){
  if(!segs.length) return;
  var target = scrollY + innerHeight*.62 - (main.getBoundingClientRect().top+scrollY);
  var len=0, hx=verts[0].x, hy=verts[0].y;
  for(var i=0;i<segs.length;i++){
    var s=segs[i];
    if(s.a.y===s.b.y){ /* 가로 */
      if(s.a.y<=target){ len=s.s+s.L; hx=s.b.x; hy=s.b.y; } else break;
    } else { /* 세로 */
      if(s.b.y<=target){ len=s.s+s.L; hx=s.b.x; hy=s.b.y; }
      else { var k=Math.max(0,target-s.a.y); len=s.s+k; hx=s.a.x; hy=s.a.y+k; break; }
    }
  }
  live.style.strokeDashoffset = (total-len);
  head.setAttribute('x',hx-2.5); head.setAttribute('y',hy-2.5);
  ring.setAttribute('x',hx-6.5); ring.setAttribute('y',hy-6.5);
  $$('.knot',knotsG).forEach(function(k){ k.classList.toggle('on', +k.dataset.y < hy-1 || (+k.dataset.y<=hy+1 && len>0)); });
}

/* ============================================================
   [JS 07] nav · folio · 배경 gray · 챕터 내부 진행률
   ============================================================ */
var sections=$$('.chapter'), navLinks=$$('.nav a'), folioA=$('#folioA'), folioB=$('#folioB'), navProg=$('#navProg'), curId='';
function swapFolio(sec){
