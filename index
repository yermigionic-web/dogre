}
var lb=$('#lb'), lbImg=$('#lbImg'), lbFig=$('#lbFig'), lbCap=$('#lbCap'), lastBtn=null;
watch(lbImg);
$$('.arc-btn').forEach(function(b){
  b.addEventListener('click',function(){
    var src=$('img',b).getAttribute('src'); lastBtn=b;
    lbFig.dataset.file=src; lbFig.classList.remove('missing'); lbImg.src=src;
